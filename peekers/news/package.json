{
  "name": "polymarket-news-daemon",
  "version": "1.0.0",
  "description": "Background daemon for collecting news headlines for Polymarket edge analysis",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile polymarket-news-daemon",
    "dev": "bun run --watch src/index.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^4.3.4"
  },
  "devDependencies": {
    "bun-types": "^1.0.0"
  }
}
